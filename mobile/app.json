{
  "expo": {
    "name": "VECI",
    "slug": "ayudar-trazable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ebf3ed"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayudartrazable.vecinal"
    },
    "android": {
      "package": "com.ayudartrazable.vecinal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ebf3ed"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite acceder a la cámara para escanear y validar tu DNI de forma segura."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite ubicar tu domicilio para conectarte con los vecinos de tu cuadrante."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "09d3f4f3-dcef-452d-bf91-86781eb205e8"
      }
    },
    "owner": "u22234838"
  }
}
